# Face & QR Attendance Management System Configuration
# You can freely customize these values. Restart or refresh the application to apply changes.

# Daily Attendance Cutoff Time (24-hour format: HH:MM, e.g. 10:30, 09:45, 11:15)
# After this cutoff time, unmarked students are marked ABSENT and absentee notification emails are triggered.
ATTENDANCE_CUTOFF_TIME=10:30

# MySQL Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=attendance_system


