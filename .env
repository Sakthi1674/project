# Face & QR Attendance Management System Configuration
# You can freely customize these values. Restart or refresh the application to apply changes.

# Daily Attendance Cutoff Time (HH:MM AM/PM or HH:MM 24-hr, e.g. 10:30 AM, 09:45 AM, 11:15 AM)
# After this cutoff time, unmarked students are marked ABSENT.
ATTENDANCE_CUTOFF_TIME=10:30 AM

# MySQL Database Settings
DB_HOST=127.0.0.1
